{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "node_modules/{better-auth,@better-auth,jose}/**/*"
    },
    "src/server.ts": {
      "includeFiles": "node_modules/{better-auth,@better-auth,jose}/**/*"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/process-expired-rentals",
      "schedule": "0 0 * * *"
    }
  ]
}
